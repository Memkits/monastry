name = "moonbit-community/moonast"

version = "0.1.0"

import {
  "moonbitlang/parser@0.3.9",
  "moonbitlang/lexer@0.3.9",
  "tiye/respo@0.3.4",
  "tiye/dom-ffi@0.2.3",
}

